{
  "name": "verificar-chassi-desktop",
  "version": "1.0.0",
  "description": "App desktop do Verificador de Chassi (janela nativa, com opção de sempre-visível)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.verificarchassi.desktop",
    "productName": "Verificador de Chassi",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
